{
  "id": "satisfier-llm-dispatch-reached",
  "description": "Explanatory goal routes to the llm_completion_dispatch satisfier; the producer answers; the LLM reach judge says reached.",
  "covers": [
    "satisfier reach",
    "§1.2 11555-11632 final judge view",
    "§1.2 11950-12059 alpha gate",
    "§1.2 12319-12401 mint gate"
  ],
  "routes": [
    {
      "id": "llm:arg-extraction",
      "method": "POST",
      "caller": "goal-host:pointer_arg_extraction",
      "respond": {
        "llm": "{\"prompt\": \"Explain why the sky looks blue during the day\"}"
      }
    },
    {
      "id": "schema:llm_completion_dispatch",
      "method": "POST",
      "type": "resolver_schema",
      "body": [
        "\"shape\":\"llm_completion_dispatch\""
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "resolver_schema",
          "body": {
            "shape": "llm_completion_dispatch",
            "known": true,
            "fields": [
              {
                "name": "prompt",
                "required": true,
                "type": "string",
                "synthesize_from": [
                  "goal",
                  "upstream"
                ]
              },
              {
                "name": "system_prompt",
                "required": false,
                "type": "string"
              },
              {
                "name": "max_tokens",
                "required": false,
                "type": "number"
              }
            ]
          }
        }
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"the answer explains Rayleigh scattering of short wavelengths\", \"completion_shapes\": [\"llm_completion_dispatch\"]}"
      }
    },
    {
      "id": "producer:llm_completion_dispatch",
      "method": "POST",
      "type": "llm_completion_dispatch",
      "body": [
        "\"prompt\""
      ],
      "bodyNot": [
        "goal-host:floor_tool_loop"
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "Sunlight scatters off air molecules; shorter blue wavelengths scatter most (Rayleigh scattering), so the sky looks blue."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Explain why the sky looks blue during the day",
        "tags": [
          "operator:verdict-diff"
        ]
      }
    }
  ]
}
