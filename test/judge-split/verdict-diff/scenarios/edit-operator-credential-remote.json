{
  "id": "edit-operator-credential-remote",
  "description": "The same operator dispatch with its ApiKey, but the compose producer is a non-loopback peer: the operator key must never leave the host.",
  "covers": [
    "operator credential never sent to a discovery-resolved peer"
  ],
  "files": {
    "/workspace/git/vessels/goal-host-vessel/src/quiesce.ts": "export const VERDICT_DIFF_MARKER = \"verdict-diff\";\n"
