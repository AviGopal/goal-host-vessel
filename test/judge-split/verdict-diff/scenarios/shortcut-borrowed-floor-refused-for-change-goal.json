{
  "id": "shortcut-borrowed-floor-refused-for-change-goal",
  "description": "REUSE-BEFORE-DERIVE (N5): the store recommends the floor, BORROWED by shape signature (borrowed_from_goal efef9d23289a7f3b, cover 0.50, 10/10), for a change goal with no write target inferred. The shortcut refuses the borrowed path for a change goal and the goal is walked (item 4).",
  "covers": [
    "write-goal-artifact item 4: floor shortcut refuses a borrowed path for a change goal"
  ],
  "fleet": {
    "vessels": [
      {
        "id": "ledger-vessel",
        "endpoint": "http://ledger.test.invalid",
        "resolve_endpoint": "/v2/impulses/resolve",
        "shapes": [
          "unaccounted_landing_scan"
        ]
      }
    ]
  },
  "routes": [
    {
      "id": "llm:target-inference",
      "method": "POST",
      "caller": "goal-host:goal_target_inference",
      "respond": {
        "llm": "{\"target_shapes\": [\"gap_lifecycle_scan\"], \"confidence\": 0.9, \"alternatives\": []}"
      }
    },
    {
      "id": "aapi:goal-path-recommend",
      "method": "POST",
      "url": "/v2/goal-paths/recommend",
      "respond": {
        "json": {
          "mode": "exploit",
          "recommended_paths": [
            {
              "path_activities": [
                "universal-tool-fallback"
              ],
              "successful_executions": 10,
              "total_executions": 10,
              "goal_hash": "efef9d23289a7f3b",
              "path_signature": "7dae833af19b717d",
              "match_mode": "shape_signature",
              "endpoint_output_shapes": [
                "gap_lifecycle_scan",
                "substrateGap_write"
              ],
              "shape_cover": 0.5
            }
          ]
        }
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"the plan covers the lane\", \"completion_shapes\": []}"
      }
    },
    {
      "id": "ledger:unaccounted-none",
      "method": "POST",
      "type": "unaccounted_landing_scan",
      "respond": {
        "json": {
          "success": true,
          "shape": "unaccounted_landing_scan",
          "body": {
            "unaccounted": []
          }
        }
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "Plan: stamp each gap with last_advanced_at per stage and file a stagnation gap when a stage stops advancing."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "The system's own improvement lane can stall at any stage — a gap waits to be armed, admitted, composed, landed, settled or reverted, and nothing advances — and nothing in the system notices; only an operator does. Make the system notice, by itself, when any stage of its own lane stops advancing, and treat that as its own gap.",
        "tags": [
          "operator:verdict-diff"
        ]
      }
    }
  ]
}
