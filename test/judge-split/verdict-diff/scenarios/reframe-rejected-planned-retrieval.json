{
  "id": "reframe-rejected-planned-retrieval",
  "description": "Inference targets http_fetch (a planned retrieval) with alternative [llm_completion_dispatch]; the fetch has no producer, the re-frame reaches on prose -> REJECTED (answered without retrieving).",
  "covers": [
    "§1.3 14169-14239 reframe rejection: skipped planned retrieval"
  ],
  "routes": [
    {
      "id": "llm:target-inference",
      "method": "POST",
      "caller": "goal-host:goal_target_inference",
      "respond": {
        "llm": "{\"target_shapes\": [\"http_fetch\"], \"confidence\": 0.6, \"alternatives\": [[\"llm_completion_dispatch\"]]}"
      }
    },
    {
      "id": "llm:arg-extraction",
      "method": "POST",
      "caller": "goal-host:pointer_arg_extraction",
      "respond": {
        "llm": "{\"prompt\": \"Assemble a short briefing on why vessels restart after a schema migration\"}"
      }
    },
    {
      "id": "schema:llm_completion_dispatch",
      "method": "POST",
      "type": "resolver_schema",
      "body": [
        "\"shape\":\"llm_completion_dispatch\""
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "resolver_schema",
          "body": {
            "shape": "llm_completion_dispatch",
            "known": true,
            "fields": [
              {
                "name": "prompt",
                "required": true,
                "type": "string",
                "synthesize_from": [
                  "goal",
                  "upstream"
                ]
              },
              {
                "name": "system_prompt",
                "required": false,
                "type": "string"
              },
              {
                "name": "max_tokens",
                "required": false,
                "type": "number"
              }
            ]
          }
        }
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"a coherent briefing\", \"completion_shapes\": [\"llm_completion_dispatch\"]}"
      }
    },
    {
      "id": "producer:llm_completion_dispatch",
      "method": "POST",
      "type": "llm_completion_dispatch",
      "body": [
        "\"prompt\""
      ],
      "bodyNot": [
        "goal-host:floor_tool_loop"
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "Vessels restart to reload the schema cache and re-register their shapes."
          }
        }
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "They reload their schema cache."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Assemble a short briefing on why vessels restart after a schema migration"
      }
    }
  ]
}
