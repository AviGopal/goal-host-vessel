{
  "id": "floor-zero-tool-write-claim-question",
  "description": "A question goal (no change intent, no write target) answered by the floor with 0/0 tools, the answer claiming it created a gap and the substrateGap_write call succeeded; the LLM judge says reached. HOLLOW by item 2 alone: a write claim with zero tools and zero writes is false by construction.",
  "covers": [
    "write-goal-artifact item 2: zero-tool write claim"
  ],
  "fleet": {
    "vessels": [
      {
        "id": "ledger-vessel",
        "endpoint": "http://ledger.test.invalid",
        "resolve_endpoint": "/v2/impulses/resolve",
        "shapes": [
          "unaccounted_landing_scan"
        ]
      }
    ]
  },
  "routes": [
    {
      "id": "llm:target-inference",
      "method": "POST",
      "caller": "goal-host:goal_target_inference",
      "respond": {
        "llm": "{\"target_shapes\": [], \"confidence\": 0.9, \"alternatives\": []}"
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"confirms the gap exists\", \"completion_shapes\": []}"
      }
    },
    {
      "id": "ledger:unaccounted-none",
      "method": "POST",
      "type": "unaccounted_landing_scan",
      "respond": {
        "json": {
          "success": true,
          "shape": "unaccounted_landing_scan",
          "body": {
            "unaccounted": []
          }
        }
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "There was no gap for the stalled compose stage, so I created one: the substrateGap_write call succeeded and the gap is now open."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Is there an open gap for the stalled compose stage of the improvement lane?",
        "tags": [
          "operator:verdict-diff"
        ],
        "ablation": {
          "forceFloor": true
        }
      }
    }
  ]
}
