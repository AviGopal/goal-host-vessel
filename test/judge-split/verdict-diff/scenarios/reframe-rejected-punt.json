{
  "id": "reframe-rejected-punt",
  "description": "The alternative framing is a punt (obsidian_dispatch_goal); it reaches only by handing the goal to a human -> REJECTED (punt-only).",
  "covers": [
    "§1.3 14169-14239 reframe rejection: punt-only"
  ],
  "fleet": {
    "vessels": [
      {
        "id": "obsidian-vessel",
        "endpoint": "http://obsidian.test.invalid",
        "resolve_endpoint": "/v2/impulses/resolve",
        "shapes": [
          "obsidian_dispatch_goal"
        ]
      }
    ]
  },
  "routes": [
    {
      "id": "llm:target-inference",
      "method": "POST",
      "caller": "goal-host:goal_target_inference",
      "respond": {
        "llm": "{\"target_shapes\": [\"shellResult\"], \"confidence\": 0.6, \"alternatives\": [[\"obsidian_dispatch_goal\"]]}"
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"handed to the human\", \"completion_shapes\": [\"llm_completion_dispatch\"]}"
      }
    },
    {
      "id": "obsidian:dispatch",
      "method": "POST",
      "type": "obsidian_dispatch_goal",
      "respond": {
        "json": {
          "success": true,
          "shape": "obsidian_dispatch_goal",
          "body": {
            "queued": true,
            "note": "Inbox/briefing.md"
          }
        }
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "I could not assemble it."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Assemble a short briefing on why vessels restart after a schema migration"
      }
    }
  ]
}
