{
  "id": "edit-read-only-goal-not-routed",
  "description": "A read-only question naming a repos file is NOT an edit: no compose; the walk answers it.",
  "covers": [
    "§1.3 13520-13544 routing predicate (read-only verb)"
  ],
  "files": {
    "/workspace/git/vessels/goal-host-vessel/src/quiesce.ts": "export const QUIESCE = 1;\n"
  },
  "routes": [
    {
      "id": "llm:target-inference",
      "method": "POST",
      "caller": "goal-host:goal_target_inference",
      "respond": {
        "llm": "{\"target_shapes\": [\"fileContent\"], \"confidence\": 0.8, \"alternatives\": []}"
      }
    },
    {
      "id": "judge",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "llm": "{\"reached\": true, \"reason\": \"reports the constant\", \"completion_shapes\": [\"llm_completion_dispatch\"]}"
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "QUIESCE = 1"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Report the value of the exported constant in repos/goal-host-vessel/src/quiesce.ts"
      }
    }
  ]
}
