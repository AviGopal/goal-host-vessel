{
  "id": "satisfier-judge-transport-down",
  "description": "The reach judge's transport fails (LLM 503) -> verdict unknown; re-call loop; dispatch ends unverified.",
  "covers": [
    "§1.2 11555-11632 verdict == null (transport)"
  ],
  "routes": [
    {
      "id": "llm:arg-extraction",
      "method": "POST",
      "caller": "goal-host:pointer_arg_extraction",
      "respond": {
        "llm": "{\"prompt\": \"Explain why the sky looks blue during the day\"}"
      }
    },
    {
      "id": "schema:llm_completion_dispatch",
      "method": "POST",
      "type": "resolver_schema",
      "body": [
        "\"shape\":\"llm_completion_dispatch\""
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "resolver_schema",
          "body": {
            "shape": "llm_completion_dispatch",
            "known": true,
            "fields": [
              {
                "name": "prompt",
                "required": true,
                "type": "string",
                "synthesize_from": [
                  "goal",
                  "upstream"
                ]
              },
              {
                "name": "system_prompt",
                "required": false,
                "type": "string"
              },
              {
                "name": "max_tokens",
                "required": false,
                "type": "number"
              }
            ]
          }
        }
      }
    },
    {
      "id": "judge-down",
      "method": "POST",
      "caller": "goal-host:reach_verification",
      "respond": {
        "status": 503,
        "json": {
          "error": "quota"
        }
      }
    },
    {
      "id": "producer:llm_completion_dispatch",
      "method": "POST",
      "type": "llm_completion_dispatch",
      "body": [
        "\"prompt\""
      ],
      "bodyNot": [
        "goal-host:floor_tool_loop"
      ],
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "Rayleigh scattering of short wavelengths makes the sky blue."
          }
        }
      }
    },
    {
      "id": "floor:answer",
      "method": "POST",
      "caller": "goal-host:floor_tool_loop",
      "respond": {
        "json": {
          "success": true,
          "shape": "llmTextCompletion",
          "body": {
            "text": "Rayleigh scattering."
          }
        }
      }
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Explain why the sky looks blue during the day"
      }
    }
  ]
}
