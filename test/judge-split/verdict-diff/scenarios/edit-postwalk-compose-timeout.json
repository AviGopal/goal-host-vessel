{
  "id": "edit-postwalk-compose-timeout",
  "description": "Early compose UNFAVORABLE; the post-walk compose times out at the caller (retried once), recovery has no template and THROWS, so the landed latch is never consulted; the catch path terminalizes the dispatch.",
  "covers": [
    "§1.3 14462-14531 post-walk compose transient retry",
    "§1.4 17747-17782 catch path",
    "landed latch NOT reached (recovery throws)"
  ],
  "files": {
    "/workspace/git/vessels/goal-host-vessel/src/quiesce.ts": "export const VERDICT_DIFF_MARKER = \"verdict-diff\";\n"
  },
  "routes": [
    {
      "id": "dev:feature_compose",
      "method": "POST",
      "type": "feature_compose",
      "sequence": [
        {
          "json": {
            "success": true,
            "shape": "composeReport",
            "body": {
              "verdict": "UNFAVORABLE",
              "execution_id": "feature-compose-exec-1",
              "stage": "verify",
              "error": "typecheck failed: TS2304 cannot find name"
            }
          }
        },
        {
          "throw": "The operation timed out."
        }
      ]
    }
  ],
  "spawn": [
    {
      "id": "git:probe-miss",
      "argsInclude": [
        "log",
        "origin/dev",
        "--grep="
      ],
      "times": 3,
      "stdout": ""
    },
    {
      "id": "git:landed-commit",
      "argsInclude": [
        "log",
        "origin/dev",
        "--grep="
      ],
      "stdout": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\u001f{{now_s}}\u001ffeat(quiesce): add the constant\n\nGap: {{grep}}\n\u001e"
    },
    {
      "id": "git:show-diff",
      "argsInclude": [
        "show",
        "--unified=0"
      ],
      "stdout": "@@ -1,0 +2 @@\n+export const VERDICT_DIFF_MARKER = \"verdict-diff\";\n"
    }
  ],
  "steps": [
    {
      "op": "runGoal",
      "body": {
        "goal": "Add a constant VERDICT_DIFF_MARKER to repos/goal-host-vessel/src/quiesce.ts that names the harness",
        "operator": "operator:verdict-diff"
      }
    }
  ]
}
